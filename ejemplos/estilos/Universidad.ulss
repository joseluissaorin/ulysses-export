//
// Academica
//
// Export style for lecture summaries and essays
//
// Visit http://www.ulysses.app/styles
// for full reference
//


//
// Document & Layout Settings
//

document-settings {
	page-inset-top:		25mm;	page-inset-inner:	25mm
	page-inset-bottom:	25mm;	page-inset-outer:	25mm

	section-break:			heading-1
	// Continue on a new page after dividers

	two-sided:				no
	page-binding:			left

	footnote-enumeration:	per-section
	footnote-placement:		end-of-page
	footnote-style:			decimal
}



//
// Default Typography
//

defaults {
	font-family:			"Optima"
	font-weight:			normal
	font-size:				12pt
	line-height:			18pt

	orphans-and-widows:		prevented

	text-alignment:			justified
	hyphenation:			no
}



//
// Basic Non-Text-Area Page Layout
//

area-header {
	content:				none
}

area-header:first-page {
	content:				none
}


area-footnotes {
	font-size:				10pt
	line-height:			14pt

	top-spacing:			3mm

	text-inset:				0pt

	divider-length:			55mm
	divider-width:			0.5pt
}

area-footnotes:anchor {
	font-weight:			bold
}

area-footer {
	content:				page-number
	text-alignment:			center
	top-spacing:			3mm
	bottom-spacing:			10mm
	font-size:				10pt
}

@code {
	font-family:			"Courier New"
	font-size:				9pt
	font-weight:			normal
	font-slant:				normal
	// Reset all traits to normal, since this can appear anywhere
}



//
// Headers
//

heading-all {
	font-weight:			bold
	keep-with-following:	true
	text-alignment:			left
}

heading-1 {
	font-size:				18pt
	line-height:			24pt
	margin-bottom:			1mm
	text-alignment:			center
}

heading-2 {
	font-size:				16pt
	line-height:			22pt
	margin-bottom:			1mm
	margin-top:				2mm

}

heading-3 {
	font-size:				14pt
	line-height:			20pt

	margin-top: 			3mm
	margin-bottom:			1mm
}

heading-4 {
	font-size:				13pt
	line-height:			18pt

	margin-bottom:			1mm
}

heading-5 {
	font-size:				13pt
	line-height:			18pt

	underline:				single
	margin-bottom:			1mm
}

heading-6 {
	font-size:				10pt
	line-height:			12pt
	margin-bottom:			1mm
}



//
// Paragraph styles
//

paragraph {
	margin-bottom:			1mm
	margin-top:				1mm
	hyphenation:			no
	first-line-indent: 		12.5mm
}
paragraph:first {
	margin-top:				3mm
}

paragraph-divider {
	page-break: after
	content:				""
	visibility:				visible
}



//
// Tables styles
//

table {
	border-top-style:		solid
	border-top-width:		1pt
	border-bottom-style:	solid
	border-bottom-width:	1pt
}

table-cell {
	padding-right:			10pt
	padding-bottom:			5pt
	line-height:			18pt
}

table-cell :header {
	row-separator-style: 	solid
	row-separator-width:	1pt
}

table-cell :header-row-boundary {
	row-separator-style: 	solid
	row-separator-width:	1pt
}


//
// Images
//

paragraph-figure {
	margin-top:				5mm
	margin-bottom:			3mm
	margin-right:			25mm
	margin-left:			25mm
}

figure-caption {
	font-size:				10pt
	line-height:			15pt
	margin-top:				3mm
	text-alignment:			center
}



//
// Block styles
//

block-code : @code {
	first-line-indent:		-4em
	line-height:			120%
	font-color:				#000000
	margin-left:			4em
	margin-right:			0mm
	margin-bottom:			6mm
	margin-top:				6mm
}

block-code paragraph{
	margin-top:				0pt
	margin-bottom:			0pt
	hyphenation:			no
	default-tab-interval:	4em
}

block-quote{
	margin-left:			15mm
	margin-right:			15mm
	margin-top:				5mm
}

block-quote paragraph{
	hyphenation:			no

	keep-with-following:	yes
}

block-raw {
	visibility:				hidden
	// kills raw source blocks
}

block-comment {
	visibility:				visible

	margin-top:				0pt
	margin-left:			13mm

	font-color:				#838383
}



//
// List styles
//

list-all {
	margin-left:			5mm
}

list-all paragraph {
	margin-top:				1mm
	margin-bottom:			0mm
}

list-all list-all {
	margin-top:				0pt
	margin-bottom:			0pt
	// No extra spacings between nested ordered and unordered lists
}

list-ordered {
	enumeration-format:		"%d."
	text-inset:				1.3em
	// Simulates tab stop justified right
}

list-ordered list-ordered {
	enumeration-format:		"%*%d"
	text-inset:				4em
	// Simulates tab stop justified right
}

list-ordered list-ordered list-ordered {
	enumeration-format:		"%*.%d"
	text-inset:				6em
	// Simulates tab stop justified right
}

list-unordered {
	enumeration-format:		"-"
	text-inset:				1.3em
	// Simulates tab stop justified right
}

list-unordered list-unordered {
	enumeration-format:		"*"
	text-inset:				4em
	// Simulates tab stop justified right
}



//
// Inline styles
//

inline-strong {
	font-weight:			bold
}

inline-emphasis {
	font-slant:				italic
}

inline-mark {
	background-color:		#E5E5E5
}

inline-citation {
	font-slant:				italic
}

inline-code : @code {
	// Nothing else to set here, since it inherits from @code
}

inline-link {
	font-family:			"Courier New"
	underline:				single
}

inline-footnote {
	font-weight:			bold
}

inline-comment {
	visibility:				hidden
	font-color:				#77787B
	background-color:		#E6E7E8
}

inline-annotation {
	background-color:		#dadada
}

inline-annotation:anchor {
	background-color:		#ffffff
}

inline-raw {
	visibility:				hidden
	// kills raw source
}

inline-delete {
	strikethrough:			single
	strikethrough-color:	#000000
}



//
// Ulysses specific stuff
// By default, we are hiding tags (##) etc.
//

inline-comment ulysses-tag {
	visibility:				visible
}

inline-comment inline-strong ulysses-tag {
	visibility:				visible
}

inline-comment inline-emphasis ulysses-tag {
	visibility:				hidden
}

inline-comment inline-link ulysses-tag {
	visibility:				hidden
}

inline-comment inline-annotation ulysses-tag {
	visibility:				hidden
}

inline-comment inline-code ulysses-tag {
	visibility:				hidden
}

inline-comment inline-delete ulysses-tag {
	visibility:				hidden
}

inline-comment inline-mark ulysses-tag {
	visibility:				hidden
}



//
// Syntax styles
//

syntax-all {
}

syntax-entity {
	font-color:				#7a7a7a
	font-weight:			bold
}

syntax-tag {
	font-color:				#000000
	font-weight:			bold
}

syntax-keyword {
	font-color:				#000000
	font-weight:			bold
	font-slant:				italic
}

syntax-parameter {
	font-color:				#777777
	font-weight:			bold
	font-slant:				italic
}

syntax-string {
	font-color:				#555555
	font-slant:				italic
}

syntax-constant {
	font-color:				#555555
	font-weight:			bold
	underline:				single
}

syntax-variable {
	font-color:				#555555
	font-weight:			bold
	underline:				single
	font-slant:				italic
}

syntax-escape {
	font-weight:			bold
	font-color:				#333333
}

syntax-comment {
	font-color:				#999999
}

syntax-error {
	font-color:				#999999
	font-weight:			bold
}



//
// Markup styles
//

syntax-heading {
	font-weight:			bold
	font-color:				#000000
	font-slant:				italic
}

syntax-italic {
	font-slant:				italic
	font-slant:				italic
}

syntax-bold {
	font-weight:			bold
	font-slant:				italic
}

syntax-deleted {
	font-color:				#999999
	font-slant:				italic
}

syntax-inserted {
	font-color:				#000000
	font-weight:			bold
	font-slant:				italic
}

syntax-changed {
	font-color:				#555555
	font-slant:				italic
}

syntax-link {
	underline:				single
	font-color:				#000000
	font-slant:				italic
}

syntax-list {
	font-color:				#000000
}